{
  "name": "神秘",
  "power": 0.8,
  "temper": 0.9,
  "goal": {"knowledge": 0.2, "entropy": 0.7},
  "affinity": {"knowledge": 0.9, "entropy": 0.5},
  "state_init": {"rage": 0.0, "ema_align": 0.5, "progress": 0.0},
  "ema": {"alpha": 0.1},
  "perceive": {
    "rage": "rage * 0.9 + abs(entropy - 0.5) * 0.1",
    "ema_align": "ema_align * (1 - alpha) + align * alpha",
    "progress": "clamp(progress + 0.02 * temper * (align - 0.4), 0, 1)"
  },
  "modes": {
    "push": {
      "score": "ema_align * 1.0 + 0.1",
      "deltas": {
        "knowledge": "power * (1 + 2 * progress) * (goal_knowledge - knowledge) * aff_knowledge * 0.2",
        "entropy":   "power * (1 + 2 * progress) * (goal_entropy - entropy) * aff_entropy * 0.2"
      }
    },
    "strike": {
      "score": "rage * 2.0 + temper * 0.1",
      "deltas": {
        "knowledge": "power * (1 + 2 * progress) * (goal_knowledge - knowledge) * aff_knowledge * 0.3",
        "entropy":   "power * (1 + 2 * progress) * (goal_entropy - entropy) * aff_entropy * 0.3"
      }
    },
    "adapt": {
      "score": "temper * 0.15",
      "deltas": {
        "knowledge": "power * (1 + 2 * progress) * (goal_knowledge - knowledge) * aff_knowledge * 0.1",
        "entropy":   "power * (1 + 2 * progress) * (goal_entropy - entropy) * aff_entropy * 0.1"
      }
    },
    "wait": {"score": "0.05", "deltas": {}}
  }
}
